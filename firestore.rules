rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Standard rule: allow reading any PGL ledger registry data.
    // Restrict writes to authenticated users, or allow guest operators securely.
    match /pgl_agents/{agentId} {
      allow read, write: if true;
    }
    
    match /pgl_ledger_events/{eventId} {
      allow read, write: if true;
    }
    
    match /pgl_incidents/{incidentId} {
      allow read, write: if true;
    }
    
    match /pgl_config/{configId} {
      allow read, write: if true;
    }
  }
}
