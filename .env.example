# Gemini powers the optional /api/chat and /api/analyze-genome helpers in server.ts.
GEMINI_API_KEY=""

# Ollama is the default notary provider through the Genome Ledger backend.
# External providers are BYOK and optional; customers enter their own keys in the UI.
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="llama3.1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PGL: where server.ts forwards /api/v1, /health and /.well-known/* requests.
# Local dev: the gnomledger backend on its canonical port. In the Veklom Docker stack: http://gnomledger-api:8001
PGL_BACKEND_URL="http://127.0.0.1:8001"

# PGL: API key the Studio server adds to every Genome Ledger request (deployed mode).
# Issue a dedicated key on the gnomledger account; it never reaches the browser.
PGL_STUDIO_API_KEY=""

# PGL (local dev only): bootstrap token for first-run account creation against an
# empty gnomledger database. Must match BOOTSTRAP_ADMIN_TOKEN on the backend.
# Leave unset when deployed: it is baked into the browser bundle at build time.
VITE_PGL_BOOTSTRAP_TOKEN="dev-bootstrap-token"
