# Ollama is the default notary provider through the Genome Ledger backend.
# External providers are BYOK and optional; customers enter their own keys in the UI.
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="llama3.1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PGL: bootstrap token for first-run account creation against gnomledger.
# Must match BOOTSTRAP_ADMIN_TOKEN configured on the gnomledger backend.
VITE_PGL_BOOTSTRAP_TOKEN="dev-bootstrap-token"

# PGL: internal Coolify/Docker URL for the Genome Ledger backend.
# Override this when the backend service alias is not `gnomledger`.
PGL_BACKEND_URL="http://gnomledger:8000"
